---
// Baked in at build time, so it updates automatically on every deploy.
// Pinned to US Eastern so the date doesn't roll over early just because
// Netlify's build servers run on UTC.
const lastUpdated = new Date().toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "America/New_York",
});
---

<footer class="site-foot">
  <div class="container site-foot__inner">
    <p>A student research project.</p>
    <p>Last updated {lastUpdated}</p>
  </div>
</footer>

<style>
  .site-foot {
    border-top: 1px solid var(--border);
    margin-top: 2rem;
  }

  .site-foot__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .site-foot p {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--muted-foreground);
    margin: 0;
  }
</style>
